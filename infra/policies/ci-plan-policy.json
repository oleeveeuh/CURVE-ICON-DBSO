{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "${state_bucket_arn}",
        "${state_bucket_arn}/*"
      ]
    },
    {
      "Sid": "ReadLockTableMetadata",
      "Effect": "Allow",
      "Action": "dynamodb:DescribeTable",
      "Resource": "${lock_table_arn}"
    },
    {
      "Sid": "ReadManagedServicesForPlanning",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "elasticloadbalancing:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:ListImages",
        "logs:Describe*",
        "logs:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "budgets:ViewBudget",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadArtifactBucketForPlanning",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": [
        "${artifact_bucket_arn}",
        "${artifact_bucket_arn}/*"
      ]
    }
  ]
}
