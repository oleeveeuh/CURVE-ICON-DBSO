{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyArtifactWrites",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketVersioning",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "${artifact_bucket_arn}",
        "${artifact_bucket_arn}/*"
      ]
    },
    {
      "Sid": "DenySecretStores",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory"
      ],
      "Resource": "*"
    }
  ]
}
